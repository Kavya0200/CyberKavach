# CyberKavach Server Environment Configuration

# Server Port
PORT=5000

# Google Gemini API Key (for multimodal payment screenshot extraction)
# Get a free API key at: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# MongoDB Connection String (Atlas or Local)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/cyberkavach?retryWrites=true&w=majority
# If omitted or offline, CyberKavach runs smoothly in resilient local fallback store
MONGODB_URI=
