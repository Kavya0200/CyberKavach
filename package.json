{
  "name": "cyberkavach",
  "version": "1.0.0",
  "description": "CyberKavach - Citizen Cybercrime Triage & Golden-Hour Fraud Response Portal",
  "private": true,
  "scripts": {
    "start": "node server/src/index.js",
    "build": "cd server && npm install",
    "postinstall": "cd server && npm install",
    "install:all": "npm install && cd server && npm install && cd ../client && npm install",
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "dev": "npm run server"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongoose": "^8.12.1",
    "multer": "^1.4.5-lts.1"
  },
  "keywords": [
    "cybercrime",
    "triage",
    "golden-hour",
    "gemini-ai",
    "fraud-reporting",
    "ncrp-1930"
  ],
  "author": "",
  "license": "ISC"
}
